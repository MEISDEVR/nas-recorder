{
  "name": "nas-recorder",
  "productName": "NAS Recorder",
  "version": "1.0.0",
  "description": "录屏幕、系统声音和麦克风解说，直接保存到本机或 NAS。桌面版 + NAS/Docker 网页版。",
  "main": "desktop/main.js",
  "license": "MIT",
  "author": "MEISDEVR",
  "homepage": "https://github.com/MEISDEVR/nas-recorder",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.minchuan.nasrecorder",
    "productName": "NAS Recorder",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "public/**",
      "desktop/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "NAS Recorder",
      "language": "2052",
      "artifactName": "NAS-Recorder-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "NAS-Recorder-${version}-portable.exe"
    }
  }
}
